# LiveKit. Leave empty for a local `livekit-server --dev` (ws://localhost:7880, devkey/secret).
# Fill in for LiveKit Cloud or your own server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Voice agent: start the LLM before the user has surely finished (faster, but extra Groq calls)
PREEMPTIVE_GENERATION_ENABLED=true
# Bell tone when the turn passes between the user and the agent
TURN_BELL_ENABLED=true

# LLM: groq or openai
LLM_PROVIDER=groq
# Groq model id (or OpenAI model id when LLM_PROVIDER=openai)
LLM_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
# Models the test console dropdown offers, comma-separated. Empty shows all. Keys: groq-gpt-oss-20b,
# groq-gpt-oss-120b, openai-gpt-5-mini, openai-gpt-5-mini-minimal, openai-gpt-4.1-mini
MODEL_OPTIONS=
# Language used by 'chat' without --language and by the evaluation scripts: en or pl
DEFAULT_LANGUAGE_CODE=en
# SCARD profile the avatar runs on: contact buttons and the fixed contact message (path relative to the project root)
CLIENT_PROFILE_PATH=profiles/smart4u.json
GROQ_API_KEY=
# Optional, paid: unlocks the OpenAI models in the test console's model picker
OPENAI_API_KEY=

# Speech-to-text on CPU (faster-whisper), one model per language. Polish needs a multilingual model.
SPEECH_RECOGNITION_MODEL_EN=base.en
SPEECH_RECOGNITION_MODEL_PL=small

# ElevenLabs. Set ELEVENLABS_ENABLED=false to switch every ElevenLabs call off.
ELEVENLABS_ENABLED=true
ELEVENLABS_API_KEY=
# Empty = default stock voice
ELEVENLABS_VOICE_ID=
# Empty = same voice as ELEVENLABS_VOICE_ID
ELEVENLABS_VOICE_ID_PL=
# Voice picker: ElevenLabs voice ids, comma-separated, shown on the pages as Voice 1, Voice 2, ... (never the ids).
# The first is the default; switching works during a call. Empty = no picker, each language uses the voice above.
# Format: ELEVENLABS_VOICE_IDS=<default voice id>,<voice 2 id>,<voice 3 id>   (client voice ids: keep them out of git)
ELEVENLABS_VOICE_IDS=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Speech-to-text: elevenlabs (Scribe realtime) or local (faster-whisper). elevenlabs falls back to local without a key.
SPEECH_TO_TEXT_PROVIDER=elevenlabs
# Spoken replies in voice calls; false = replies are text only
ELEVENLABS_TEXT_TO_SPEECH_ENABLED=true

# Avatar: Ditto on the GPU. false = calls are voice only (also when the avatar is busy or unreachable).
AVATAR_ENABLED=false
# On the pod: ws://127.0.0.1:8090 (the local avatar service). From this PC: wss://<pod-id>-8080.proxy.runpod.net
AVATAR_SERVICE_URL=
# The avatar service's password: the same text as the VIRAONE_API_KEY its server was started with
AVATAR_SERVICE_API_KEY=
# The face the avatar animates (uploaded automatically) and the pages show (empty = assets/avatar_portrait.jpg)
AVATAR_PORTRAIT_PATH=

# Local service addresses (defaults are fine on one machine)
SPEECH_SERVER_HOST=127.0.0.1
SPEECH_SERVER_PORT=8101

# Test console and voice page (/voice): 127.0.0.1 = this PC only, 0.0.0.0 = reachable from the network.
# Voice calls also need the browser to reach LIVEKIT_URL, which is localhost by default.
WEB_SERVER_HOST=127.0.0.1
WEB_SERVER_PORT=8080
