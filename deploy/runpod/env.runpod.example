# chatbot/.env for the RunPod pod: the whole pipeline on one RTX 4090. setup.sh copies this to chatbot/.env and fills
# in the generated passwords; add your own keys with set_key.sh (hidden input, never in the shell history):
#   bash /workspace/Ditto-Viraone-Live-Avatar-streaming/deploy/runpod/set_key.sh OPENAI_API_KEY
#   bash /workspace/Ditto-Viraone-Live-Avatar-streaming/deploy/runpod/set_key.sh ELEVENLABS_API_KEY
# start.sh sets the pod-specific addresses (LiveKit links, public IP, avatar address) itself.

# ---- your keys ----
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional: the free Groq models in the console's model picker
GROQ_API_KEY=

# ---- generated by setup.sh (keep them secret) ----
# LiveKit server on the pod signs every call with these
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The Ditto avatar service's password (the agent and Ditto share it; Ditto listens on the pod only)
AVATAR_SERVICE_API_KEY=
# The test page's password: the browser asks for it once (type any user name)
WEB_ACCESS_PASSWORD=

# ---- LLM: OpenAI gpt-4.1-mini (the plan's choice: no hidden thinking, quickest to first word) ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_REASONING_EFFORT=low
# The models the page offers (the OpenAI ones; add groq-gpt-oss-20b once GROQ_API_KEY is set)
MODEL_OPTIONS=openai-gpt-4.1-mini,openai-gpt-5-mini-minimal
DEFAULT_LANGUAGE_CODE=en
CLIENT_PROFILE_PATH=profiles/smart4u.json
PREEMPTIVE_GENERATION_ENABLED=true
TURN_BELL_ENABLED=true

# ---- ElevenLabs: Scribe realtime speech-to-text + Flash speech ----
ELEVENLABS_ENABLED=true
ELEVENLABS_TEXT_TO_SPEECH_ENABLED=true
SPEECH_TO_TEXT_PROVIDER=elevenlabs
ELEVENLABS_MODEL=eleven_flash_v2_5
# Empty = the default stock voice; set a Polish voice with set_key.sh ELEVENLABS_VOICE_ID_PL
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_PL=
# Voice picker: ElevenLabs voice ids, comma-separated, shown on the pages as Voice 1, Voice 2, ... (never the ids).
# The first is the default; switching works during a call. Empty = no picker, each language uses the voice above.
# Format: ELEVENLABS_VOICE_IDS=<default voice id>,<voice 2 id>,<voice 3 id>   (client voice ids: keep them out of git)
ELEVENLABS_VOICE_IDS=
# Local fallback speech-to-text (only used when ElevenLabs is off)
SPEECH_RECOGNITION_MODEL_EN=base.en
SPEECH_RECOGNITION_MODEL_PL=small

# ---- Avatar: Ditto on the same GPU, approved look + tested real-time speed (server/avatar_stream.py) ----
AVATAR_ENABLED=true
AVATAR_SERVICE_URL=ws://127.0.0.1:8090
# The approved selfie, relative to chatbot/
AVATAR_PORTRAIT_PATH=assets/avatar_portrait.jpg

# ---- test page on the pod's HTTPS link (port 8080) ----
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# SCARD widget: sites allowed to use this server from the browser, comma-separated (e.g. https://scard.example.com).
# "*" = any site (fine for testing; list the SCARD site for the client).
WIDGET_ALLOWED_ORIGINS=*

# Session safeguards (PoC agreement, section 3). 0 turns a limit off; restart the server after a change.
# Every call ends after SESSION_MAX_SECONDS, or after SESSION_INACTIVITY_SECONDS with nobody speaking.
SESSION_MAX_SECONDS=180
SESSION_INACTIVITY_SECONDS=30
# Widget visitors only (the console pages are exempt): one call at a time, and at most this many calls per hour.
SESSIONS_PER_VISITOR_PER_HOUR=3
# Backstop per IP address: call tickets per hour, and requests of any kind per minute.
SESSIONS_PER_IP_PER_HOUR=10
RATE_LIMIT_REQUESTS_PER_MINUTE=60
